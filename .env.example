# The local env, for a clone with no secrets repo: copy this file to .env and fill it in.
# With the secrets repo cloned at ~/.config/sops/envs, the values come from
# creator-analytics/local.env there instead, and this file only names what must arrive.
# It names the values the wrapped commands read, and no other. `pnpm env:check` says
# whether every name below arrives. An empty value counts.
#
# `pnpm migrate` runs the migrations against this database as app_migrator.
MIGRATION_DATABASE_URL=
# The Cloudflare Access service token that `pnpm build:extension:staging` builds in.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
