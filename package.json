{
  "name": "creator-analytics",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "node apps/site/test/screenshot/browser-walk.ts",
    "build": "pnpm -r build",
    "build:extension:staging": "node scripts/with-env.mjs build:extension:staging",
    "migrate": "node scripts/with-env.mjs migrate",
    "env:check": "node scripts/check-local-env.mjs",
    "check:private": "node scripts/check-private-terms.mjs",
    "fonts": "pnpm --filter @creator-analytics/visual-system fonts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
